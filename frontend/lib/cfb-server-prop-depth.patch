+    o.playerName||
+    o.player?.name||
+    o.participantName||
+    o.participant?.name||
+    o.entityName||
+    ""
+  ).trim();
+}
+
+function sgoLine(o:any){
+  return safeNumber(
+    o.bookOverUnder??o.overUnder??o.line??o.point??
