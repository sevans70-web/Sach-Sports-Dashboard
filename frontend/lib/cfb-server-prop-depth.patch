+function normStat(v:any){
+  return String(v||"").toLowerCase().replace(/[^a-z0-9]/g,"");
+}
+
+const SGO_STAT_NORMALIZED:Record<CfbMarketKey,Set<string>>=Object.fromEntries(
+  Object.entries(SGO_STATS).map(([market,aliases])=>[
+    market,
+    new Set((aliases as string[]).map(normStat)),
+  ])
+) as Record<CfbMarketKey,Set<string>>;
+
+function sgoStatCandidates(o:any){
+  return [
+    o.statID,o.statId,o.stat,
+    o.marketID,o.marketId,o.market,
+    o.betTypeID,o.betTypeId,o.betType,
+    o.statName,o.marketName,o.label,o.name,
+  ].filter(Boolean);
+}
+
+function sgoMatchesMarket(o:any,market:CfbMarketKey){
+  const wanted=SGO_STAT_NORMALIZED[market];
+  return sgoStatCandidates(o).some(v=>wanted.has(normStat(v)));
+}
+
+function sgoSide(o:any){
+  return String(o.sideID||o.sideId||o.side||o.outcome||o.name||"").toLowerCase();
+}
+
+function sgoPlayerName(o:any){
+  return String(
+    o.statEntityName||
