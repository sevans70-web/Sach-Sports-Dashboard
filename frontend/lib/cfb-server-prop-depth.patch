+  );
+}
+
+function sgoPrice(o:any){
+  return safeNumber(
+    o.fairOdds??o.bookOdds??o.odds??o.price??
+    o.americanOdds
+  );
+}
+
+function sgoBooks(o:any){
+  const raw=o.byBookmaker||o.bookmakers||o.books||o.sportsbooks;
+  if(Array.isArray(raw))return raw.length;
+  if(raw&&typeof raw==="object")return Object.keys(raw).length;
+  // A SportsGameOdds row with a posted book line is still sportsbook-backed
+  // even when the response does not include the byBookmaker expansion.
+  return sgoLine(o)!=null||sgoPrice(o)!=null?1:0;
+}
